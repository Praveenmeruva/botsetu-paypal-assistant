# PayPal sandbox app (https://developer.paypal.com -> Apps & Credentials -> Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
# Optional: sandbox business email used as invoice issuer (Invoicing API)
PAYPAL_INVOICER_EMAIL=
# Leave PayPal vars empty to run in offline MOCK mode (no network calls to PayPal)

# AI model: any OpenAI-compatible chat endpoint with tool calling
# Sarvam: LLM_BASE_URL=https://api.sarvam.ai/v1  LLM_MODEL=sarvam-105b
LLM_BASE_URL=https://api.sarvam.ai/v1
LLM_MODEL=sarvam-105b
LLM_API_KEY=
# Falls back to SARVAM_API_KEY if LLM_API_KEY is empty
SARVAM_API_KEY=

PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
CURRENCY=USD
